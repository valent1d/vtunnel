{
  // Static-assets-only Cloudflare Worker that serves the vtunnel website
  // (landing page + install.sh) from the site/ directory. Deployed via
  // `npx wrangler deploy` by Cloudflare Workers Builds on every push.
  "name": "vtunnel-website",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
  },
  "observability": {
    "enabled": true,
  },
}
